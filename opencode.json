{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "edit": {
      "/tmp/**": "allow"
    }
  }
}
