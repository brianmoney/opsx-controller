# Legacy fallback only. Prefer models.toml: run `opsx-plan models init` to
# seed ~/.config/opsx-controller/models.toml (or copy models.example.toml),
# which resolves per adapter and per role and takes precedence over these
# variables once it exists. These ambient OPSX_*_MODEL variables are
# consulted only as a last resort, so existing .env-based setups keep
# working until you create models.toml.
#
# The values below are examples only — replace them with models your adapter
# actually supports.
OPSX_CONTROLLER_MODEL=github-copilot/gpt-5.4
OPSX_IMPLEMENTER_MODEL=deepseek/deepseek-v4-pro
# OPSX_IMPLEMENTER_ESCALATION_MODEL=deepseek/deepseek-v4-ultra  # optional, for escalate_after_review_fails
OPSX_REVIEWER_MODEL=github-copilot/gpt-5.4
OPSX_ARCHIVER_MODEL=github-copilot/gpt-5.4
